{
  "compilerOptions": {
    "target": "ES2023",
    // DOM + DOM.Iterable type the browser globals used inside the functions we
    // inject into Zen's chrome window via ZenDriver.exec (document, events,
    // MutationObserver, NodeList iteration, ...). Chrome-only globals that the
    // DOM lib doesn't know about (gBrowser, Services, window.zenTidyTabs) are
    // declared in src/chrome-globals.d.ts.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "noEmit": true
  },
  "include": [
    "src",
    "specs",
    "manual",
    "playwright.config.ts",
    "manual.config.ts"
  ]
}
